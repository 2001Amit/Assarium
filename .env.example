# Assarium configuration
#
#   cp .env.example apps/api/.env
#
# Every setting is an environment variable prefixed ASSARIUM_. Full explanation of where
# each credential comes from: docs/GO_LIVE.md
#
# ---------------------------------------------------------------------------------------
# THE ONE RULE
#
#   Platform credentials go here. Source credentials never do.
#
# A customer's Postgres password, Snowflake key or SharePoint client secret is entered in
# the Connect dialog in the browser, goes straight to Key Vault, and only a reference is
# kept in our database. If you are pasting a customer credential into this file, stop.
#
# The four values marked KEY VAULT below must not be written into a file at all, even in
# production. They come from the deployment platform's secret injection.
# ---------------------------------------------------------------------------------------


# =========================================================================================
# LOCAL DEVELOPMENT - this is the entire file you need
# =========================================================================================

ASSARIUM_ENVIRONMENT=local
ASSARIUM_ENGINE=duckdb

# Everything below has a working default. The encryption key is generated into
# ~/.assarium/secret.key on first run, the metadata store is SQLite in the same folder,
# and authentication uses a fixed local identity that the app refuses to allow outside a
# local environment.


# =========================================================================================
# PRODUCTION - uncomment and fill. The app refuses to start if any of this is inconsistent.
# =========================================================================================

# ASSARIUM_ENVIRONMENT=production
# ASSARIUM_DEBUG=false


# --- Identity ----------------------------------------------------------------------------
# auth_mode "local" accepts one fixed identity for every caller and is refused outside a
# local environment. Production is always "entra".
#
# ENTRA_AUDIENCE is the Application ID URI of the API's app registration (Entra ID ->
# App registrations -> Expose an API). It is not a secret.
#
# ENTRA_ALLOWED_TENANT_IDS restricts which directories may authenticate at all. Leaving it
# empty still gates on the tenant registry, but naming them rejects an unknown directory
# before we spend a network call on its JWKS.

# ASSARIUM_AUTH_MODE=entra
# ASSARIUM_ENTRA_AUDIENCE=api://assarium-api
# ASSARIUM_ENTRA_ALLOWED_TENANT_IDS=["00000000-0000-0000-0000-000000000000"]


# --- Secrets -----------------------------------------------------------------------------
# "keyvault" resolves source credentials from Azure Key Vault through the compute's
# managed identity. "local" keeps them in an encrypted file and is refused outside local.
#
# The managed identity needs Key Vault Secrets OFFICER, not User: the app writes source
# credentials as well as reading them.

# ASSARIUM_SECRETS_BACKEND=keyvault
# ASSARIUM_KEY_VAULT_URL=https://kv-assarium-dev-001.vault.azure.net/

# KEY VAULT - inject at deploy, do not put the value in this file.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ASSARIUM_SECRET_KEY=


# --- Metadata store ----------------------------------------------------------------------
# Tenants, connections, datasets, run history, dashboards. Holds Key Vault references,
# never secret values.
#
# Defaults to SQLite at ~/.assarium/assarium.db. SQLite is one file on one machine, so two
# API replicas would each have their own - use Postgres for anything shared.
#
# KEY VAULT - inject at deploy.
# ASSARIUM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/assarium


# --- Compute engine ----------------------------------------------------------------------
# "databricks" is the only supported production value. DuckDB is a single-node test fixture
# that provides no tenant isolation, and the app refuses it outside local.
#
# HOST is the hostname only: no https://, no trailing slash.
# HTTP_PATH comes from SQL Warehouses -> your warehouse -> Connection details. Prefer a
# serverless warehouse; a classic one takes minutes to start and the first dashboard load
# of the day will look broken.
#
# Authentication is OAuth M2M with a service principal. Personal access tokens are not
# used anywhere in this platform.

# ASSARIUM_ENGINE=databricks
# ASSARIUM_DATABRICKS_HOST=adb-1234567890123456.7.azuredatabricks.net
# ASSARIUM_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123def456
# ASSARIUM_DATABRICKS_CLIENT_ID=

# KEY VAULT - inject at deploy.
# ASSARIUM_DATABRICKS_CLIENT_SECRET=

# One catalog per tenant: {prefix}_{environment}_{tenant_slug}. The catalog is the
# isolation boundary, not a row filter.
# ASSARIUM_CATALOG_PREFIX=assarium
# ASSARIUM_CONTROL_CATALOG=assarium_prod_platform


# --- Azure OpenAI (optional) -------------------------------------------------------------
# Only the AI explanations and the Ask tab need this. Everything else works without it.
#
# Prefer USE_ENTRA_ID=true: the managed identity needs the "Cognitive Services OpenAI User"
# role and there is then no key to rotate or leak. Fall back to an API key only if you
# cannot grant that role.

# ASSARIUM_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# ASSARIUM_AZURE_OPENAI_DEPLOYMENT=gpt-4o
# ASSARIUM_AZURE_OPENAI_USE_ENTRA_ID=true

# KEY VAULT - inject at deploy, and only if not using Entra above.
# ASSARIUM_AZURE_OPENAI_API_KEY=


# --- Frontend origin ---------------------------------------------------------------------
# Exact origins only. A wildcard here with credentials enabled would let any site read
# a signed-in user's data.

# ASSARIUM_CORS_ORIGINS=["https://app.assarium.com"]


# --- Orchestration -----------------------------------------------------------------------
# The runner polls for due schedules, takes a lock, runs the pipeline, and releases with
# the outcome. Locking is a conditional update, so several replicas are safe.

ASSARIUM_SCHEDULER_ENABLED=true
ASSARIUM_SCHEDULER_POLL_SECONDS=30

# Slack, Teams, PagerDuty or any webhook. A JSON payload per pipeline event.
# ASSARIUM_ALERT_WEBHOOK_URL=


# --- Safety rails ------------------------------------------------------------------------
# Caps on anything the analysis layer executes on a user's behalf.

ASSARIUM_QUERY_ROW_LIMIT=50000
ASSARIUM_QUERY_TIMEOUT_SECONDS=120
ASSARIUM_PROFILE_SAMPLE_ROWS=50000
